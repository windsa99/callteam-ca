<script type="application/ld+json">
{"@context":"https://schema.org","@graph":[
{"@type":"WebPage","@id":"{{ canonicalUrl }}#webpage","url":"{{ canonicalUrl }}","name":{{ seoTitle | json | safe }},"description":{{ description | json | safe }},"isPartOf":{"@id":"{{ site.websiteId }}"},"publisher":{"@id":"{{ site.organizationId }}"},"datePublished":"2026-10-25T00:00:00Z","dateModified":"2026-10-25T00:00:00Z","mainEntity":{"@id":"{{ canonicalUrl }}#offering"},"breadcrumb":{"@id":"{{ canonicalUrl }}#breadcrumb"},"inLanguage":"en"},
{"@type":"{{ config.kind }}","@id":"{{ canonicalUrl }}#offering","name":{{ config.name | json | safe }},"url":"{{ canonicalUrl }}","description":{{ description | json | safe }},"provider":{"@id":"{{ site.organizationId }}"}{% if config.kind == "WebApplication" %},"applicationCategory":"BusinessApplication","operatingSystem":"Any","browserRequirements":"JavaScript enabled for interactive results","isAccessibleForFree":true{% else %},"serviceType":"B2B fintech lead generation and appointment setting"{% endif %}},
{"@type":"BreadcrumbList","@id":"{{ canonicalUrl }}#breadcrumb","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"{{ site.url }}/"},{"@type":"ListItem","position":2,"name":{{ config.name | json | safe }},"item":"{{ canonicalUrl }}"}]},
{"@type":"FAQPage","@id":"{{ canonicalUrl }}#faq","mainEntity":[{% for item in config.faq %}{"@type":"Question","name":{{ item[0] | json | safe }},"acceptedAnswer":{"@type":"Answer","text":{{ item[1] | json | safe }}}}{% if not loop.last %},{% endif %}{% endfor %}]}
]}
</script>

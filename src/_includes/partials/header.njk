<header>
  <a href="/" class="logo">
    <img src="/assets/images/callteam-logo.png" alt="{{ site.name }}">
  </a>

  <input type="checkbox" id="menu-toggle" class="menu-toggle">

  <nav class="nav-links">
    {% for item in navigation %}
      {% if item.children %}
        <div class="nav-group">
          <a href="{{ item.url }}" class="nav-group-link">{{ item.label }} <span aria-hidden="true">⌄</span></a>
          <div class="nav-dropdown" aria-label="{{ item.label }} menu">
            {% for child in item.children %}
              <a href="{{ child.url }}">
                <strong>{{ child.label }}</strong>
                <small>{{ child.description }}</small>
              </a>
            {% endfor %}
          </div>
        </div>
      {% else %}
        <a href="{{ item.url }}">{{ item.label }}</a>
      {% endif %}
    {% endfor %}
  </nav>

  <div class="header-right">
    <a href="https://calendly.com/hello-callteam/new-meeting" class="header-cta" target="_blank" rel="noopener">{{ site.ctaText }}</a>
    <label for="menu-toggle" class="burger-icon" aria-label="Open menu">
      <span></span><span></span><span></span>
    </label>
  </div>
</header>

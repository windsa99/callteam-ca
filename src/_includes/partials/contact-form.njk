<section class="contact-section" id="contact">
  <div class="contact-wrap">
    <div>
      <div class="section-label">Get in touch</div>
      <h2>Tell us where your pipeline is breaking.</h2>
      <p>Need more leads, more calls, more booked appointments, better sales execution, or a stronger pipeline system? Send a message and we will get back to you.</p>
    </div>
    <form class="contact-form" action="https://formspree.io/f/xbdvejea" method="POST">
      <div class="form-row">
        <label for="name">Your name *</label>
        <input type="text" id="name" name="name" required>
      </div>
      <div class="form-row">
        <label for="company">Company name *</label>
        <input type="text" id="company" name="company" required>
      </div>
      <div class="form-row">
        <label for="email">Email *</label>
        <input type="email" id="email" name="email" required>
      </div>
      <div class="form-row">
        <label for="message">What do you need help with? *</label>
        <textarea id="message" name="message" required></textarea>
      </div>
      <button type="submit" class="form-submit">Send Message</button>
      <div class="form-note">We'll reply within one business day.</div>
    </form>
  </div>
</section>

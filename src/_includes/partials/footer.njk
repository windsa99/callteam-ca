{% from "components/chrome-extension.njk" import storeBadge with context %}
<footer id="site-footer">
  <div class="footer-top">
    <div class="footer-brand">
      <a href="/" class="logo">
      <img src="/assets/images/callteam-logo.png" alt="{{ site.name }}" class="footer-logo-image">
      </a>
      <p>Human-led B2B outbound, qualification, appointment setting, sales execution, and revenue systems.</p>
      <div class="ct-footer-extension">
        <a class="ct-footer-extension-title" href="/cold-call-script-chrome-extension/">Our free Cold Call Script Picker</a>
        {{ storeBadge("footer") }}
      </div>
      <a class="ct-footer-recognition" href="/awards/">Internationally recognised for B2B outbound calling & appointment setting.</a>
      <div class="ct-footer-awards ct-footer-awards--four" aria-label="CallTeam award winners">
        {% for key, award in awards %}
        <a class="ct-footer-award{% if award.imageKind == 'programme' %} ct-footer-award--programme{% endif %}" data-award-key="{{ key }}" data-award-placement="footer" href="{{ award.url }}" aria-label="{{ award.title }} · {{ award.programme }} · {{ award.edition }}" title="{{ award.title }}">
          <img src="{{ award.image }}" width="{{ award.imageWidth or award.size }}" height="{{ award.imageHeight or award.size }}" alt="{{ award.label }}" loading="lazy" decoding="async">
          <span>{{ award.footerLabel }}</span>
        </a>
        {% endfor %}
      </div>
    </div>
    <div class="footer-nav-column">
      <strong>Services</strong>
      {% for child in navigation[0].children %}
        <a href="{{ child.url }}">{{ child.label }}</a>
      {% endfor %}
    </div>
    <div class="footer-nav-column">
      <strong>Outbound Library</strong>
      <a href="/resources/outbound-sales-library/">Outbound Sales Library</a>
      <!-- ROI calculator link -->
      <a href="/b2b-lead-generation-roi-calculator/">ROI Calculator</a>
      <!-- /ROI calculator link -->
      <!-- Campaign preview link -->
      <a href="/b2b-outbound-campaign-planner/">Campaign Preview</a>
      <!-- /Campaign preview link -->
      <a href="/lead-generation-proposal-comparison/">Compare Agency Proposals</a>
      <a href="/resources/cold-call-scripts/">Cold-Call Scripts</a>
      <a href="/cold-call-script-chrome-extension/">Free Chrome Extension</a>
      <a href="/cold-call-script-checker/">Check Your Cold Call Script</a>
      <a href="/b2b-meeting-quality-check/">Meeting Quality Check</a>
      <a href="/resources/outbound-playbooks/industries/">Industry Playbooks</a>
      <a href="/resources/outbound-playbooks/buyers/">Buyer Playbooks</a>
      <a href="/articles/cold-call-objection-handling/">Objection Database</a>
      <a href="/resources/outbound-campaign-strategy/">Qualification and Campaign Strategy</a>
    </div>
    <div class="footer-nav-column">
      <strong>CallTeam</strong>
      <a href="/about/">About CallTeam</a>
      <a href="/videos/callteam-process-demo/" data-process-video-placement="footer">Watch how we work · 78 sec</a>
      <a href="/awards/" id="footer-awards-link">Awards & Recognition</a>
      <a href="/services/">All Services</a>
      <a href="/pricing/">Pricing</a>
      <a href="/case-studies/">Case Studies</a>
      <a href="/articles/">All Sales Articles</a>
      <a href="/#faq">FAQ</a>
      <a href="/#contact">Contact</a>
    </div>
    <div class="footer-contact">
      <strong>Start a conversation</strong>
      <div><a href="mailto:{{ site.email }}">{{ site.email }}</a></div>
      <a href="https://calendly.com/hello-callteam/new-meeting" target="_blank" rel="noopener">Book a free strategy call →</a>
    </div>
  </div>
  <div class="footer-bottom">
    <span>&copy; 2026 CallTeam.ca</span>
    <div class="flinks">
      <span>B2B sales execution for the United States, North America, and global markets.</span>
    </div>
  </div>
</footer>

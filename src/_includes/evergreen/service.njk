<script type="application/ld+json">{"@context":"https://schema.org","@graph":[{"@type":"WebPage","@id":"{{ canonicalUrl }}#webpage","url":"{{ canonicalUrl }}","name":{{ offer.title | json | safe }},"description":{{ offer.description | json | safe }},"mainEntity":{"@id":"{{ canonicalUrl }}#service"},"isPartOf":{"@id":"{{ site.websiteId }}"},"publisher":{"@id":"{{ site.organizationId }}"},"breadcrumb":{"@id":"{{ canonicalUrl }}#breadcrumb"},"inLanguage":"en"},{"@type":"Service","@id":"{{ canonicalUrl }}#service","url":"{{ canonicalUrl }}","name":{{ offer.h1 | json | safe }},"description":{{ offer.intro | json | safe }},"provider":{"@id":"{{ site.organizationId }}"},"areaServed":[{"@type":"Country","name":"Canada"},{"@type":"Country","name":"United States"}],"serviceType":"B2B lead generation and appointment setting"},{"@type":"BreadcrumbList","@id":"{{ canonicalUrl }}#breadcrumb","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://www.callteam.ca/"},{"@type":"ListItem","position":2,"name":"Services","item":"https://www.callteam.ca/services/"},{"@type":"ListItem","position":3,"name":{{ offer.h1 | json | safe }},"item":"{{ canonicalUrl }}"}]},{"@type":"FAQPage","mainEntity":[{% for f in offer.faqs %}{"@type":"Question","name":{{ f[0] | json | safe }},"acceptedAnswer":{"@type":"Answer","text":{{ f[1] | json | safe }}}}{% if not loop.last %},{% endif %}{% endfor %}]}]}</script>
<main class="ev-page ev-{{ offer.key }}">
<div class="ev-hero-shell"><div class="ev-wrap"><nav class="ev-breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><a href="/services/">Services</a><span>/</span><span aria-current="page">{{ offer.eyebrow }}</span></nav>
<div class="ev-hero"><div><p class="ev-kicker">{{ offer.eyebrow }}</p><h1>{% if offer.key == "small" %}B2B Lead Generation Services <span class="ev-highlight">for Small Businesses</span>{% else %}Professional Services <span class="ev-highlight">Lead Generation and Appointment Setting</span>{% endif %}</h1><p class="ev-tagline">{{ offer.headline }}</p><p class="ev-intro">{{ offer.intro }}</p><a class="btn-primary ev-button" href="https://calendly.com/hello-callteam/new-meeting" target="_blank" rel="noopener">{{ offer.cta }} <span aria-hidden="true">↗</span></a><p class="ev-micro">Free 30-minute strategy call · Discuss your market, scope and fit.</p><p class="ev-micro">Serving Canada and the United States. Other markets by agreement.</p></div>
<aside class="ev-sheet" aria-label="Campaign responsibilities"><div class="ev-sheet-top"><span>CallTeam / Campaign brief</span><span>01</span></div><h2>{{ offer.heroLabel }}</h2><dl>{% for row in offer.heroRows %}<div><dt>{{ row[0] }}</dt><dd>{{ row[1] }}</dd></div>{% endfor %}</dl><div class="ev-sheet-stamp"><span class="ev-dot"></span> Human calling. Useful buyer context.</div></aside></div>
<div class="ev-trust"><p><strong>500,000+</strong> outbound calls</p><p><strong>1,000+</strong> sellers coached</p><p><strong>150+</strong> companies supported</p><p><strong>Fortune 100/500</strong> sales experience</p></div><p class="ev-caption ev-experience">Combined professional experience behind CallTeam.</p></div></div>
<nav class="ev-jump" aria-label="On this page"><div class="ev-wrap"><a href="#starting-point">Your situation</a><a href="#the-work">Campaign scope</a><a href="#responsibilities">Responsibilities</a><a href="#campaign-proof">Campaign evidence</a><a href="#investment">Pricing and fit</a><a href="#questions">Questions</a></div></nav>
<section class="ev-section" id="starting-point"><div class="ev-wrap"><div class="ev-heading"><p class="ev-kicker">{{ offer.sectionLabel }}</p><h2>{{ offer.sectionTitle }}</h2><p>{{ offer.sectionIntro }}</p></div><div class="ev-cards">{% for card in offer.cards %}<article class="ev-card"><p class="ev-card-label">{{ card.label }}</p><h3>{{ card.title }}</h3><p>{{ card.text }}</p><div class="ev-action"><strong>How CallTeam helps</strong><p>{{ card.action }}</p></div></article>{% endfor %}</div></div></section>
<section class="ev-section ev-paper" id="the-work"><div class="ev-wrap ev-split"><div class="ev-heading"><p class="ev-kicker">02 / From account to conversation</p><h2>{{ offer.processTitle }}</h2><p>{{ offer.processIntro }}</p></div><ol class="ev-steps">{% for step in offer.steps %}<li><span>0{{ loop.index }}</span><div><h3>{{ step[0] }}</h3><p>{{ step[1] }}</p></div></li>{% endfor %}</ol></div></section>
<section class="ev-section" id="responsibilities"><div class="ev-wrap"><div class="ev-heading"><p class="ev-kicker">03 / A clear working agreement</p><h2>{{ offer.ownershipTitle }}</h2><p>{{ offer.ownershipIntro }}</p></div><div class="ev-ownership"><article><p class="ev-card-label">CallTeam</p><h3>We manage the agreed outreach.</h3><ul>{% for item in offer.ours %}<li>{{ item }}</li>{% endfor %}</ul></article><article><p class="ev-card-label">Your business</p><h3>You lead the commercial decisions.</h3><ul>{% for item in offer.yours %}<li>{{ item }}</li>{% endfor %}</ul></article></div></div></section>
<section class="ev-section ev-proof" id="campaign-proof"><div class="ev-wrap"><p class="ev-kicker">{{ offer.proofLabel }}</p><div class="ev-proof-grid"><div><h2>{{ offer.proofTitle }}</h2><p>{{ offer.proofText }}</p><a class="ev-light-link" href="{{ offer.proofUrl }}">{{ offer.proofLink }} <span aria-hidden="true">→</span></a></div><div class="ev-stats">{% for stat in offer.stats %}<div><strong>{{ stat[0] }}</strong><span>{{ stat[1] }}</span></div>{% endfor %}</div></div><p class="ev-proof-note">{{ offer.proofNote }}</p></div></section>
<section class="ev-section" id="investment"><div class="ev-wrap ev-split"><div class="ev-heading"><p class="ev-kicker">04 / Pricing and campaign readiness</p><h2>{{ offer.fitTitle }}</h2><p>{{ offer.fitIntro }}</p><p>{{ offer.fitExtra }}</p></div><aside class="ev-price"><p class="ev-card-label">Managed outbound programs from</p><p class="ev-price-number">US$4,000<span>per month</span></p><p>{{ offer.fitBody }}</p><a class="ev-text-link" href="/pricing/">Review pricing and full program scope →</a></aside></div></section>
<section class="ev-section ev-paper" id="questions"><div class="ev-wrap ev-split"><div class="ev-heading"><p class="ev-kicker">Before you decide</p><h2>Answers before the first call.</h2><p>Know what the service involves and what your team needs to bring.</p></div><div class="ev-faqs">{% for faq in offer.faqs %}<details><summary>{{ faq[0] }}</summary><p>{{ faq[1] }}</p></details>{% endfor %}</div></div></section>
<section class="ev-section"><div class="ev-wrap"><div class="ev-heading"><p class="ev-kicker">Explore the relevant detail</p><h2>Understand the work behind the service.</h2></div><div class="ev-related">{% for link in offer.links %}<a href="{{ link[0] }}"><h3>{{ link[1] }} <span aria-hidden="true">↗</span></h3><p>{{ link[2] }}</p></a>{% endfor %}</div><p class="ev-about">CallTeam is a global B2B outbound sales execution company. Experienced people handle the calls; AI assists research and preparation. <a href="/about/">Meet CallTeam</a> and <a href="/authors/harj-singh/">read about Harj Singh’s sales experience</a>.</p></div></section>
<section class="ev-final"><div class="ev-wrap"><p class="ev-kicker">Your next campaign</p><h2>{{ offer.finalTitle }}</h2><p>{{ offer.finalText }}</p><a class="btn-primary ev-button" href="https://calendly.com/hello-callteam/new-meeting" target="_blank" rel="noopener">Book a Free 30-Minute Strategy Call <span aria-hidden="true">↗</span></a></div></section>
</main>

{% from "components/inline-video.njk" import videoPlayer %}
{% if guide.video %}
<div class="po-video">
  <div>
    <h2>{{ guide.video.title }}</h2>
    <p>{{ guide.video.copy }}</p>
  </div>
  <figure class="ct-process-preview ct-process-inline{% if guide.video.height > guide.video.width %} ct-process-inline--portrait{% endif %}">
    {{ videoPlayer(guide.video.asset, guide.video.width, guide.video.height, guide.video.label, {poster: true, captions: true, placement: guide.slug}) }}
    <figcaption class="ct-process-preview__body">
      <strong>{{ guide.video.label }}</strong>
    </figcaption>
  </figure>
</div>
{% endif %}

{% macro storeBadge(placement) %}<a class="ctce-badge" href="{{ chromeExtension.storeUrl }}" target="_blank" rel="noopener" data-chrome-placement="{{ placement }}" aria-label="Get CallTeam Cold Call Script Picker on the Chrome Web Store"><img src="{{ chromeExtension.badge }}" width="496" height="150" alt="Available in the Chrome Web Store"></a>{% endmacro %}
{% macro scriptInstall(placement) %}<aside class="ctce-inline" data-chrome-promo="{{ placement }}" aria-label="Free Chrome extension"><div><strong>Use our script library beside your dialler.</strong><span>Search {{ chromeExtension.scriptCount }} scripts in Chrome. Copy an opener or objection reply.</span><a href="{{ chromeExtension.url }}" data-chrome-placement="{{ placement }}-details">See the free Script Picker →</a></div>{{ storeBadge(placement) }}</aside>{% endmacro %}
{% macro productCard(placement,title,copy) %}<aside class="ctce-card" id="chrome-{{ placement }}" data-chrome-promo="{{ placement }}"><a class="ctce-card-image" href="{{ chromeExtension.url }}" aria-label="See the CallTeam Cold Call Script Picker"><img src="{{ chromeExtension.detailScreenshot }}" width="1363" height="2120" loading="lazy" alt="Close-up of the cybersecurity opener and Copy opener control in the CallTeam extension"></a><div><p class="ctce-kicker">Free Chrome extension</p><h3>{{ title }}</h3><p>{{ copy }}</p><div class="ctce-actions">{{ storeBadge(placement) }}<a class="ctce-text-link" href="{{ chromeExtension.url }}" data-chrome-placement="{{ placement }}-details">See how it works →</a></div></div></aside>{% endmacro %}

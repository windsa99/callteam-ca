<script type="application/ld+json">
{"@context":"https://schema.org","@graph":[{"@type":"WebPage","@id":"{{ canonicalUrl }}#webpage","url":"{{ canonicalUrl }}","name":{{ title | json | safe }},"description":{{ description | json | safe }},"dateModified":"{{ guide.reviewedIso }}","inLanguage":"en-CA","isPartOf":{"@id":"{{ site.websiteId }}"},"publisher":{"@id":"{{ site.organizationId }}"},"breadcrumb":{"@id":"{{ canonicalUrl }}#breadcrumb"}},{"@type":"BreadcrumbList","@id":"{{ canonicalUrl }}#breadcrumb","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"{{ site.url }}/"},{"@type":"ListItem","position":2,"name":"Outbound Sales Library","item":"{{ site.url }}/resources/outbound-sales-library/"},{"@type":"ListItem","position":3,"name":{{ title | json | safe }},"item":"{{ canonicalUrl }}"}]},{% if guide.providers %}{"@type":"ItemList","@id":"{{ canonicalUrl }}#crm-options","name":"First CRM options for small businesses","itemListOrder":"https://schema.org/ItemListUnordered","numberOfItems":{{ guide.providers.length }},"itemListElement":[{% for p in guide.providers %}{"@type":"ListItem","position":{{ loop.index }},"name":{{ p.name | json | safe }},"url":"{{ canonicalUrl }}#{{ p.id }}"}{% if not loop.last %},{% endif %}{% endfor %}]},{% endif %}{"@type":"FAQPage","@id":"{{ canonicalUrl }}#questions","mainEntity":[{% for faq in guide.faqs %}{"@type":"Question","name":{{ faq.q | json | safe }},"acceptedAnswer":{"@type":"Answer","text":{{ faq.a | json | safe }}}}{% if not loop.last %},{% endif %}{% endfor %}]}]}
</script>
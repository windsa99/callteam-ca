{% from "components/inline-video.njk" import videoPlayer, inlineWatch %}
{% macro processVideoPreview(heading, description, placement) %}
<figure class="ct-process-preview ct-process-inline" id="{{ placement }}-video">
  {{ videoPlayer("callteam-process-demo", 1920, 1080, "CallTeam’s 78-second calling process", {poster: true, captions: true, placement: placement}) }}
  <figcaption class="ct-process-preview__body">
    <strong>{{ heading }}</strong>
    <span>{{ description }}</span>
    <a href="/videos/callteam-process-demo/#transcript">Read the transcript</a>
  </figcaption>
</figure>
{% endmacro %}

{% macro processVideoWatch(label, placement) %}
  {{ inlineWatch(label, "callteam-process-demo", 1920, 1080, true, placement) }}
{% endmacro %}

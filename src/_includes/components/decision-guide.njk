{% macro heading(number, label, title, intro) %}
<div class="lp-heading"><p class="lp-kicker">{{ number }} / {{ label }}</p><h2>{{ title | safe }}</h2>{% if intro %}<p>{{ intro | safe }}</p>{% endif %}</div>
{% endmacro %}
{% macro table(caption, headers, rows, extraClass) %}
<div class="sg-table-wrap"><table class="lp-table sg-table dg-table {{ extraClass }}" role="table"><caption>{{ caption }}</caption><thead><tr role="row">{% for h in headers %}<th scope="col" role="columnheader">{{ h }}</th>{% endfor %}</tr></thead><tbody>{% for row in rows %}<tr role="row">{% for cell in row %}{% if loop.first %}<th scope="row" role="rowheader">{{ cell | safe }}</th>{% else %}<td role="cell" data-label="{{ headers[loop.index0] }}">{{ cell | safe }}</td>{% endif %}{% endfor %}</tr>{% endfor %}</tbody></table></div>
{% endmacro %}
{% macro sources(items) %}
<p class="sg-sources">{% for s in items %}<a href="{{ s[1] }}" target="_blank" rel="noopener">{{ s[0] }} ↗</a>{% if not loop.last %} · {% endif %}{% endfor %}</p>
{% endmacro %}
{% macro hero(guide) %}
<div class="lp-hero-shell"><div class="lp-wrap"><nav class="lp-breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><a href="/resources/outbound-sales-library/">Outbound Sales Library</a><span>/</span><span aria-current="page">{{ guide.shortTitle }}</span></nav><div class="lp-hero"><div><p class="lp-kicker">The CallTeam buying desk / {{ guide.category }}</p><h1>{{ guide.h1 | safe }}</h1><p class="lp-intro">{{ guide.intro }}</p><div class="lp-actions"><a class="lp-button" href="#comparison">Compare the options ↓</a><a class="lp-text-link" href="#costs">See the costs →</a></div><p class="sg-brands">{{ guide.brands | join(' · ') }}</p></div><aside class="lp-brief"><p class="lp-kicker">{{ guide.panelLabel }}</p><h2>{{ guide.panelTitle | safe }}</h2><ol>{% for point in guide.panel %}<li><span>0{{ loop.index }}</span><div><strong>{{ point[0] }}</strong><p>{{ point[1] }}</p></div></li>{% endfor %}</ol><a href="#buying-questions">Copy five buying questions →</a></aside></div><p class="lp-direct-answer"><strong>CallTeam's quick verdict:</strong> {{ guide.quickAnswer }}</p><p class="lp-method"><strong>Prices and features checked {{ guide.reviewed }}.</strong> Official sources are linked with the comparisons.</p></div></div>
<nav class="lp-jump" aria-label="On this page"><div class="lp-wrap">{% for item in guide.jump %}<a href="#{{ item[0] }}">{{ item[1] }}</a>{% endfor %}</div></nav>
{% endmacro %}
{% macro providers(guide) %}
<div class="dg-reviews">{% for p in guide.providers %}<article class="lp-provider" id="{{ p.id }}"><header class="lp-provider-head"><div><p class="lp-kicker">{{ p.fit }}</p><h3>{{ p.name }}</h3></div><a class="lp-source" href="{{ p.sources[0][1] }}" target="_blank" rel="noopener">Official pricing ↗</a></header><p class="dg-price">{{ p.price }}</p><div class="lp-provider-body"><div class="lp-provider-detail"><h4>What it does well</h4><p>{{ p.good }}</p><h4>Where it falls short</h4><p>{{ p.weak }}</p></div><aside class="lp-verdict"><p class="lp-kicker">CallTeam verdict</p><p class="lp-verdict-text">{{ p.verdict }}</p></aside></div>{{ sources(p.sources) }}</article>{% endfor %}</div>
{% endmacro %}
{% macro midcta(guide, title, text) %}
<div class="sg-mid-cta"><p><strong>{{ title }}</strong> {{ text }}</p><a class="lp-button" href="https://calendly.com/hello-callteam/new-meeting" target="_blank" rel="noopener" data-booking-placement="{{ guide.slug }}-mid">Talk to CallTeam ↗</a></div>
{% endmacro %}
{% macro resource(guide, number) %}
<section class="lp-section lp-dark" id="buying-questions"><div class="lp-wrap">{{ heading(number, 'Free buying resource', guide.resourceTitle, guide.resourceIntro) }}<div class="sg-copy-layout"><pre id="sg-resource-text" tabindex="0" aria-label="{{ guide.resourceTitle }}">{{ guide.resource }}</pre><aside><h3>{{ guide.resourceAside }}</h3><p>{{ guide.resourceNote }}</p><button id="sg-copy-resource" class="lp-button" type="button" hidden>Copy the five questions</button><span id="sg-copy-status" role="status" aria-live="polite"></span><noscript><p>Select and copy the questions above.</p></noscript></aside></div></div></section>
{% endmacro %}
{% macro faqs(guide, number) %}
<section class="lp-section" id="questions"><div class="lp-wrap lp-faq-wrap">{{ heading(number,'Direct answers',guide.shortTitle + ':<br>frequently asked questions.','') }}<div class="lp-faqs">{% for faq in guide.faqs %}<details><summary>{{ faq.q }}</summary><p>{{ faq.a }}</p></details>{% endfor %}</div></div></section>
{% endmacro %}
{% macro close(guide) %}
<section class="lp-section lp-paper lp-close" id="hire-callteam"><div class="lp-wrap"><div class="lp-close-grid"><div><p class="lp-kicker">Put your leads to work</p><h2>{{ guide.ctaTitle | safe }}</h2><p>{{ guide.ctaText }}</p><div class="lp-actions"><a class="lp-button" href="https://calendly.com/hello-callteam/new-meeting" target="_blank" rel="noopener" data-booking-placement="{{ guide.slug }}-final">Book a free 30-minute call ↗</a><a class="lp-text-link" href="/services/b2b-cold-calling/">See our cold calling service →</a></div></div><aside><h3>Plan the campaign.</h3><a href="/b2b-outbound-campaign-planner/">Build your campaign preview<span>Choose your buyers and prepare the conversation →</span></a><a href="/case-studies/saas-demo-appointment-setting/">See a B2B calling case study<span>Read how the campaign and handoff worked →</span></a><a href="/resources/how-to-buy-cold-calling-leads/">Choose the right numbers<span>Know when to try a mobile or company line →</span></a></aside></div><div class="gr-resources"><h3>Making the calls yourself?</h3><p>Use a free script and check your opening before you dial.</p>{% include "components/free-calling-resources.njk" %}</div></div></section>
{% endmacro %}

<script type="application/ld+json">
{"@context":"https://schema.org","@graph":[{"@type":"WebPage","@id":"{{ canonicalUrl }}#webpage","url":"{{ canonicalUrl }}","name":{{ title | json | safe }},"description":{{ description | json | safe }},"dateModified":"{{ guide.reviewedIso }}","inLanguage":"en-CA","isPartOf":{"@id":"{{ site.websiteId }}"},"publisher":{"@id":"{{ site.organizationId }}"},"breadcrumb":{"@id":"{{ canonicalUrl }}#breadcrumb"},"mainEntity":{"@id":"{{ canonicalUrl }}#tools"},"about":[{"@type":"Thing","name":"Cold email software"},{"@type":"Thing","name":"B2B email outreach"}]},{"@type":"BreadcrumbList","@id":"{{ canonicalUrl }}#breadcrumb","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"{{ site.url }}/"},{"@type":"ListItem","position":2,"name":"Outbound Sales Library","item":"{{ site.url }}/resources/outbound-sales-library/"},{"@type":"ListItem","position":3,"name":"Cold email software","item":"{{ canonicalUrl }}"}]},{"@type":"ItemList","@id":"{{ canonicalUrl }}#tools","name":"Cold email software compared by CallTeam","itemListOrder":"https://schema.org/ItemListUnordered","numberOfItems":{{ guide.providers.length }},"itemListElement":[{% for p in guide.providers %}{"@type":"ListItem","position":{{ loop.index }},"name":{{ p.name | json | safe }},"url":"{{ canonicalUrl }}#{{ p.id }}"}{% if not loop.last %},{% endif %}{% endfor %}]},{"@type":"FAQPage","@id":"{{ canonicalUrl }}#questions","mainEntity":[{% for faq in guide.faqs %}{"@type":"Question","name":{{ faq.q | json | safe }},"acceptedAnswer":{"@type":"Answer","text":{{ faq.a | json | safe }}}}{% if not loop.last %},{% endif %}{% endfor %}]}]}

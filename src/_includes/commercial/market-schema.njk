<script type="application/ld+json">
{"@context":"https://schema.org","@graph":[{"@type":"WebPage","@id":"{{ canonicalUrl }}#webpage","url":"{{ canonicalUrl }}","name":{{ seoTitle | json | safe }},"description":{{ description | json | safe }},"dateModified":{{ modified | json | safe }},"inLanguage":"en-CA","isPartOf":{"@id":"{{ site.websiteId }}"},"publisher":{"@id":"{{ site.organizationId }}"},"mainEntity":{"@id":"{{ canonicalUrl }}#service"},"breadcrumb":{"@id":"{{ canonicalUrl }}#breadcrumb"}},{"@type":"Service","@id":"{{ canonicalUrl }}#service","name":{{ service.name | json | safe }},"serviceType":{{ service.serviceType | json | safe }},"description":{{ service.summary | json | safe }},"url":"{{ canonicalUrl }}","provider":{"@id":"{{ site.organizationId }}"},"areaServed":[{% for country in service.countries %}{"@type":"Country","name":{{ country | json | safe }}}{% if not loop.last %},{% endif %}{% endfor %}]},{"@type":"BreadcrumbList","@id":"{{ canonicalUrl }}#breadcrumb","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"{{ site.url }}/"},{"@type":"ListItem","position":2,"name":"Services","item":"{{ site.url }}/services/"},{"@type":"ListItem","position":3,"name":{{ service.name | json | safe }},"item":"{{ canonicalUrl }}"}]},{"@type":"FAQPage","@id":"{{ canonicalUrl }}#questions","mainEntity":[{% for item in service.faq %}{"@type":"Question","name":{{ item.q | json | safe }},"acceptedAnswer":{"@type":"Answer","text":{{ item.a | json | safe }}}}{% if not loop.last %},{% endif %}{% endfor %}]}]}
</script>

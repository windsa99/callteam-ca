<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ seoTitle or title }}</title>
<meta name="description" content="{{ description }}">
{% set resolvedCanonicalUrl = canonicalUrl or (site.url + page.url) %}
<link rel="canonical" href="{{ resolvedCanonicalUrl }}">
<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1">
{% set resolvedSocialTitle = socialTitle or seoTitle or title %}
{% set resolvedSocialDescription = socialDescription or description %}
{% set resolvedSocialImage = socialImage or "https://www.callteam.ca/assets/images/callteam-social-preview.jpg" %}
<meta property="og:type" content="{{ ogType or 'website' }}">
<meta property="og:site_name" content="CallTeam">
<meta property="og:title" content="{{ resolvedSocialTitle }}">
<meta property="og:description" content="{{ resolvedSocialDescription }}">
<meta property="og:url" content="{{ resolvedCanonicalUrl }}">
<meta property="og:image" content="{{ resolvedSocialImage }}">
<meta property="og:image:width" content="1731">
<meta property="og:image:height" content="909">
<meta property="og:image:alt" content="CallTeam B2B sales execution">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ resolvedSocialTitle }}">
<meta name="twitter:description" content="{{ resolvedSocialDescription }}">
<meta name="twitter:image" content="{{ resolvedSocialImage }}">
<meta name="twitter:image:alt" content="CallTeam B2B sales execution">
<link rel="icon" href="/assets/images/favicon.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Archivo:wght@500;700;900&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/assets/css/style.css">
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": "{{ site.organizationId }}",
      "name": {{ site.name | json | safe }},
      "alternateName": {{ site.alternateName | json | safe }},
      "url": "{{ site.url }}/",
      "logo": {
        "@type": "ImageObject",
        "url": "{{ site.logo }}"
      },
      "email": {{ site.email | json | safe }},
      "description": {{ site.description | json | safe }},
      "contactPoint": {
        "@type": "ContactPoint",
        "contactType": "sales",
        "email": {{ site.email | json | safe }},
        "url": "https://calendly.com/hello-callteam/new-meeting",
        "availableLanguage": "English"
      },
      "areaServed": [
        { "@type": "Country", "name": "United States" },
        { "@type": "Country", "name": "Canada" },
        { "@type": "Place", "name": "North America" },
        { "@type": "Place", "name": "Worldwide" }
      ]
    },
    {
      "@type": "WebSite",
      "@id": "{{ site.websiteId }}",
      "url": "{{ site.url }}/",
      "name": {{ site.name | json | safe }},
      "alternateName": {{ site.alternateName | json | safe }},
      "inLanguage": "en",
      "publisher": { "@id": "{{ site.organizationId }}" }
    }
  ]
}
</script>
{% if faqSchema %}
<script type="application/ld+json">
{{ faqSchema | safe }}
</script>
{% endif %}
<script type="text/javascript">
    (function(c,l,a,r,i,t,y){
        c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
        t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
        y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
    })(window, document, "clarity", "script", "y3d6ipt5bw");
</script>
</head>
<body>

{% include "partials/header.njk" %}

{{ content | safe }}

{% if not hasInlineContact %}
{% include "partials/contact-form.njk" %}
{% endif %}

{% include "partials/footer.njk" %}

</body>
</html>

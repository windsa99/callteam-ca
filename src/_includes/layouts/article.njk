---
layout: layouts/base.njk
ogType: article
---
{% set articleCanonical = canonicalUrl or (site.url + page.url) %}
{% set libraryParent = page.fileSlug | librarySectionFor %}
{% set isObjectionDatabase = page.fileSlug == "cold-call-objection-handling" %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": "{{ articleCanonical }}#webpage",
      "url": "{{ articleCanonical }}",
      "name": {{ title | json | safe }},
      "description": {{ description | json | safe }},
      "isPartOf": { "@id": "{{ site.websiteId }}" },
      "mainEntity": { "@id": "{{ articleCanonical }}#article" },
      "inLanguage": "en"
    },
    {
      "@type": "BlogPosting",
      "@id": "{{ articleCanonical }}#article",
      "url": "{{ articleCanonical }}",
      "mainEntityOfPage": { "@id": "{{ articleCanonical }}#webpage" },
      "headline": {{ title | json | safe }},
      "description": {{ description | json | safe }},
      "datePublished": "{{ date }}T00:00:00Z",
      "dateModified": "{{ modified or date }}T00:00:00Z",
      "author": { "@id": "{{ site.organizationId }}" },
      {% if reviewedBy %}"reviewedBy": { "@type": "Organization", "name": {{ reviewedBy | json | safe }} },
      {% endif %}
      "publisher": { "@id": "{{ site.organizationId }}" },
      "isPartOf": { "@id": "{{ site.websiteId }}" },
      "articleSection": {{ (cluster or category or "B2B Sales") | json | safe }},
      "inLanguage": "en"{% if socialImage %},
      "image": [{{ socialImage | json | safe }}]{% endif %}{% if topics and topics.length > 0 %},
      "about": [
        {%- for topic in topics %}
        { "@type": "Thing", "name": {{ topic | json | safe }} }{% if not loop.last %},{% endif %}
        {%- endfor %}
      ]{% endif %}
    },
    {
      "@type": "BreadcrumbList",
      "@id": "{{ articleCanonical }}#breadcrumb",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "{{ site.url }}/" },
        { "@type": "ListItem", "position": 2, "name": "Outbound Sales Library", "item": "{{ site.url }}/resources/outbound-sales-library/" },
        {% if isObjectionDatabase %}{ "@type": "ListItem", "position": 3, "name": "Objection Database", "item": "{{ articleCanonical }}" }
        {% else %}{ "@type": "ListItem", "position": 3, "name": {{ libraryParent.label | json | safe }}, "item": "{{ site.url }}{{ libraryParent.url }}" },
        { "@type": "ListItem", "position": 4, "name": {{ title | json | safe }}, "item": "{{ articleCanonical }}" }{% endif %}
      ]
    }{% if faqs and faqs.length > 0 %},
    {
      "@type": "FAQPage",
      "@id": "{{ articleCanonical }}#faq",
      "mainEntity": [
        {%- for item in faqs %}
        {
          "@type": "Question",
          "name": {{ item.question | json | safe }},
          "acceptedAnswer": { "@type": "Answer", "text": {{ item.answer | json | safe }} }
        }{% if not loop.last %},{% endif %}
        {%- endfor %}
      ]
    }{% endif %}{% if comparisonItems and comparisonItems.length > 0 %},
    {
      "@type": "ItemList",
      "@id": "{{ articleCanonical }}#comparison",
      "name": {{ (comparisonListName or title) | json | safe }},
      "itemListOrder": "https://schema.org/ItemListUnordered",
      "numberOfItems": {{ comparisonItems.length }},
      "itemListElement": [
        {%- for item in comparisonItems %}
        {
          "@type": "ListItem",
          "position": {{ loop.index }},
          "item": {
            "@type": "Organization",
            "name": {{ item.name | json | safe }},
            "description": {{ item.summary | json | safe }}
          }
        }{% if not loop.last %},{% endif %}
        {%- endfor %}
      ]
    }{% endif %}{% if objectionEntries and objectionEntries.length > 0 %},
    {
      "@type": "ItemList",
      "@id": "{{ articleCanonical }}#objections",
      "name": "Common B2B cold call objections",
      "numberOfItems": {{ objectionEntries.length }},
      "itemListElement": [
        {%- for item in objectionEntries %}
        {
          "@type": "ListItem",
          "position": {{ loop.index }},
          "name": {{ item.title | json | safe }},
          "url": "{{ articleCanonical }}#{{ item.id }}"
        }{% if not loop.last %},{% endif %}
        {%- endfor %}
      ]
    }{% endif %}
  ]
}
</script>

<nav class="breadcrumb-trail" aria-label="Breadcrumb">
  <div class="container">
    <a href="/">Home</a> / <a href="/resources/outbound-sales-library/">Outbound Sales Library</a> /
    {% if isObjectionDatabase %}<span>Objection Database</span>
    {% else %}<a href="{{ libraryParent.url }}">{{ libraryParent.label }}</a> / <span>{{ title }}</span>{% endif %}
  </div>
</nav>

<article class="article-page">
  <header class="hero article-hero">
    <div>
      {% if category %}<div class="eyebrow">{{ category }}</div>{% endif %}
      <h1>{{ title }}</h1>
      <p class="article-deck">{{ description }}</p>
      <div class="article-byline">
        <span>Published by <a href="/">CallTeam</a></span>
        {% if reviewedBy %}<span>Reviewed by {{ reviewedBy }}</span>{% endif %}
        <span>Published <time datetime="{{ date }}">{{ date | readableDate }}</time></span>
        <span>Updated <time datetime="{{ modified or date }}">{{ (modified or date) | readableDate }}</time></span>
      </div>
      {% if quickAnswer %}
      <div class="quick-answer">
        <strong>Quick answer:</strong> {{ quickAnswer }}
      </div>
      {% endif %}
    </div>
  </header>

  {% if cards and cards.length > 0 %}
  <section class="article-takeaways" aria-labelledby="takeaways-heading">
    <div class="container article-takeaways-inner">
      <div class="article-takeaways-heading">
        <div class="section-label">Key takeaways</div>
        <h2 id="takeaways-heading">{{ cardsHeading or "What you need to know." }}</h2>
      </div>
      <ul class="article-summary-list">
        {% for card in cards %}
        <li>
          <span class="article-summary-number" aria-hidden="true">0{{ loop.index }}</span>
          <h3>{{ card.title }}</h3>
          <p>{{ card.text }}</p>
        </li>
        {% endfor %}
      </ul>
    </div>
  </section>
  {% endif %}

  <aside class="article-library-context" aria-label="Outbound Sales Library location">
    <div class="container article-library-context-inner">
      <div>
        <span>Part of the Outbound Sales Library</span>
        <strong>{% if isObjectionDatabase %}Cold-Call Objection Database{% else %}{{ libraryParent.label }}{% endif %}</strong>
        <p>Connect this guide to the scripts, buyer context and campaign system behind a qualified sales conversation.</p>
      </div>
      <nav aria-label="Related library collections">
        {% if not isObjectionDatabase %}<a href="{{ libraryParent.url }}">Browse {{ libraryParent.shortLabel }} →</a>{% endif %}
        <a href="/resources/cold-call-scripts/">Use a cold-call script →</a>
        <a href="/resources/outbound-sales-library/">Explore the full library →</a>
      </nav>
    </div>
  </aside>

  {% if objectionEntries and objectionEntries.length > 0 %}
  <section class="objection-directory" aria-labelledby="objection-directory-heading">
    <div class="container-wide">
      <div class="library-section-heading">
        <div><div class="section-label">Objection database</div><h2 id="objection-directory-heading">Jump to the resistance you are hearing.</h2></div>
        <p>Use the response as a decision framework, not a line to recite. Clarify the meaning, answer what is true and stop when the buyer gives a clear no.</p>
      </div>
      <div class="objection-directory-grid">
        {% for item in objectionEntries %}<a href="#{{ item.id }}"><span>0{{ loop.index }}</span><strong>{{ item.title }}</strong><small>{{ item.signal }}</small></a>{% endfor %}
      </div>
      <a class="objection-deep-link" href="#objection-guides">Search every deeper objection and resistance guide →</a>
    </div>
  </section>
  {% endif %}

  <section id="article-body">
    <div class="container article-content">
      {{ content | safe }}
    </div>
  </section>

  {% if isObjectionDatabase %}
  <section id="objection-guides" class="library-finder-section objection-guides" data-resource-finder data-limit="8">
    <div class="container-wide">
      <div class="library-section-heading">
        <div><div class="section-label">Deeper objection guides</div><h2>Find the response behind the resistance.</h2></div>
        <p data-library-count aria-live="polite">Showing 8 of {{ collections.libraryObjections.length - 1 }} resources</p>
      </div>
      <div class="library-finder-controls" role="search" aria-label="Search and filter objection-handling guides">
        <label class="library-search"><span class="sr-only">Search objection guides</span><input type="search" data-library-search placeholder="Search timing, budget, incumbent, access or change risk" autocomplete="off"></label>
        <div class="library-filter-row" role="group" aria-label="Objection topics">
          <button type="button" class="is-active" data-library-filter="all" aria-pressed="true">All</button>
          <button type="button" data-library-filter="brush-offs" aria-pressed="false">Brush-Offs</button>
          <button type="button" data-library-filter="timing-budget" aria-pressed="false">Timing and Budget</button>
          <button type="button" data-library-filter="incumbent-status-quo" aria-pressed="false">Incumbent and Status Quo</button>
          <button type="button" data-library-filter="change-risk" aria-pressed="false">Change Risk</button>
          <button type="button" data-library-filter="access-trust" aria-pressed="false">Access and Trust</button>
        </div>
      </div>
      <div class="library-resource-grid">
        {% for resource in collections.libraryObjections | reverse %}
        {% if resource.fileSlug != "cold-call-objection-handling" %}
        <article class="library-resource-card" data-library-card data-track="objections" data-group="{{ resource.fileSlug | libraryGroupFor('objections') }}" data-search="{{ resource.data.title }} {{ resource.data.description }} {{ resource.data.category }} {% if resource.data.topics %}{{ resource.data.topics | join(' ') }}{% endif %}">
          <div class="library-card-top"><span>Objection guide</span><small>{{ resource.data.category }}</small></div>
          <h3><a href="{{ resource.url }}">{{ resource.data.title }}</a></h3><p>{{ resource.data.description }}</p>
          <div class="library-card-footer"><span>Updated {{ resource.data.modified | readableDate }}</span><a href="{{ resource.url }}">Read guide →</a></div>
        </article>
        {% endif %}
        {% endfor %}
      </div>
      <p class="library-empty-state" data-library-empty hidden>No objection guides match that search. Try the buyer's actual words or the underlying constraint.</p>
      <div class="library-load-row"><button type="button" class="btn-secondary" data-library-more>Show all {{ collections.libraryObjections.length - 1 }} resources</button></div>
    </div>
  </section>
  {% endif %}

  {% if relatedResources and relatedResources.length > 0 %}
  <section class="article-connections article-related-resources" aria-labelledby="related-resources-heading">
    <div class="container-wide">
      <div class="section-label">{{ relatedResourcesLabel or "Related resources" }}</div>
      <h2 id="related-resources-heading">{{ relatedResourcesHeading or "Useful resources for the next step." }}</h2>
      <div class="service-grid">
        {% for item in relatedResources %}
        <article class="service-card">
          {% if item.label %}<span class="article-card-label">{{ item.label }}</span>{% endif %}
          <h3>{{ item.title }}</h3>
          <p>{{ item.text }}</p>
          <a href="{{ item.url }}" class="card-link">{{ item.linkText or ("Explore " ~ item.title) }} →</a>
        </article>
        {% endfor %}
      </div>
    </div>
  </section>
  {% endif %}

  {% if callTeamTakeHeading and callTeamTakeA and callTeamTakeB %}
  <section class="article-perspective" aria-labelledby="callteam-take-heading">
    <div class="container">
      <div class="article-perspective-panel">
        <div class="section-label">CallTeam take</div>
        <h2 id="callteam-take-heading">{{ callTeamTakeHeading }}</h2>
        <p>{{ callTeamTakeA }}</p>
        <p>{{ callTeamTakeB }}</p>
      </div>
    </div>
  </section>
  {% endif %}

  {% if relatedService or relatedCaseStudy %}
  <section class="article-connections" aria-labelledby="connections-heading">
    <div class="container-wide">
      <div class="section-label">Connect the answer to the work</div>
      <h2 id="connections-heading">Relevant service and proof.</h2>
      <div class="service-grid">
        {% if relatedService %}
        <article class="service-card">
          <span class="article-card-label">Related service</span>
          <h3>{{ relatedService.title }}</h3>
          <p>{{ relatedService.text }}</p>
          <a href="{{ relatedService.url }}" class="card-link">Explore {{ relatedService.title }} →</a>
        </article>
        {% endif %}
        {% if relatedCaseStudy %}
        <article class="service-card">
          <span class="article-card-label">Related case study</span>
          <h3>{{ relatedCaseStudy.title }}</h3>
          <p>{{ relatedCaseStudy.text }}</p>
          <a href="{{ relatedCaseStudy.url }}" class="card-link">Read {{ relatedCaseStudy.title }} →</a>
        </article>
        {% endif %}
      </div>
    </div>
  </section>
  {% endif %}

  {% if sources and sources.length > 0 %}
  <section class="article-sources" aria-labelledby="sources-heading">
    <div class="container">
      <div class="section-label">Sources and further reading</div>
      <h2 id="sources-heading">References used for this guide.</h2>
      <ul class="help-list">
        {% for source in sources %}
        <li><a href="{{ source.url }}" class="card-link" target="_blank" rel="noopener">{{ source.name }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </section>
  {% endif %}

  {% if faqs and faqs.length > 0 %}
  <section id="faq">
    <div class="container-wide">
      <div class="section-label">FAQ</div>
      <h2>Questions B2B teams are asking.</h2>
      <div class="faq-list">
        {% for item in faqs %}
        <div class="faq-item">
          <h3>{{ item.question }}</h3>
          <p>{{ item.answer }}</p>
        </div>
        {% endfor %}
      </div>
    </div>
  </section>
  {% endif %}

  <section class="article-about" aria-labelledby="about-callteam-heading">
    <div class="container signature-block{% if aboutParagraphSpacing %} signature-block--spaced{% endif %}">
      <div class="section-label">About CallTeam</div>
      <h2 id="about-callteam-heading">{{ aboutHeading or "A global B2B outbound sales execution company." }}</h2>
      <p>{{ aboutCopyA or "CallTeam helps founders, revenue leaders, and sales teams create qualified conversations with the right business buyers. Its services include B2B lead generation, human-led cold calling, appointment setting, outsourced SDR execution, lead reactivation, AI-assisted lead generation, AI GTM services, US market entry sales, and SDR training." }}</p>
      <p>{{ aboutCopyB or "CallTeam brings together international sales talent and operating experience shaped inside demanding Fortune 100 and Fortune 500 sales environments. AI supports research, decision-maker identification, signal prioritization, and preparation. Experienced people own the conversations, qualification, objection handling, follow-up, and sales handoff." }}</p>
      {% if aboutCopyC %}<p>{{ aboutCopyC }}</p>{% endif %}
      <ul class="signature-links">
        {% if aboutLinks and aboutLinks.length > 0 %}
        {% for item in aboutLinks %}
        <li><a href="{{ item.url }}" class="card-link">{{ item.title }} →</a></li>
        {% endfor %}
        {% else %}
        <li><a href="/about/" class="card-link">Learn about CallTeam and its operating model →</a></li>
        <li><a href="/services/" class="card-link">Explore B2B sales and lead generation services →</a></li>
        <li><a href="/case-studies/" class="card-link">See B2B sales and appointment setting case studies →</a></li>
        <li><a href="/sales-execution-lab/" class="card-link">Explore B2B sales training and coaching →</a></li>
        <li><a href="/90-day-revenue-engine/" class="card-link">Explore B2B sales system consulting →</a></li>
        {% endif %}
      </ul>
    </div>
  </section>

  {% if readNext and readNext.length > 0 %}
  <section class="article-read-next" aria-labelledby="read-next-heading">
    <div class="container">
      <div class="section-label">Continue the topic</div>
      <h2 id="read-next-heading">Related B2B sales guides.</h2>
      <ul class="help-list">
        {% for item in readNext %}
        <li><a href="{{ item.url }}" class="card-link">{{ item.title }} →</a></li>
        {% endfor %}
      </ul>
    </div>
  </section>
  {% endif %}
</article>

<section class="cta-band">
  <h2>{{ ctaHeading or "Need more qualified B2B conversations?" }}</h2>
  <p>{{ ctaText or "Book a free call and let's look at where your outbound pipeline is breaking." }}</p>
  <a href="{{ ctaUrl or 'https://calendly.com/hello-callteam/new-meeting' }}" class="btn-light" target="_blank" rel="noopener">Book a Free Call</a>
</section>
{% if isObjectionDatabase %}<script src="/assets/js/outbound-library.js" defer></script>{% endif %}

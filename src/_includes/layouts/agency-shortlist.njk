---
layout: layouts/base.njk
---
{% set guide = agencyShortlists[shortlistKey] %}
<script type="application/ld+json">
{"@context":"https://schema.org","@graph":[
  {"@type":"WebPage","@id":"{{ canonicalUrl }}#webpage","url":"{{ canonicalUrl }}","name":{{ title | json | safe }},"description":{{ description | json | safe }},"inLanguage":"en-CA","breadcrumb":{"@id":"{{ canonicalUrl }}#breadcrumb"},"mainEntity":{"@id":"{{ canonicalUrl }}#article"}},
  {"@type":"Article","@id":"{{ canonicalUrl }}#article","headline":{{ title | json | safe }},"description":{{ description | json | safe }},"datePublished":"{{ date | sitemapDate }}","dateModified":"{{ modified }}","mainEntityOfPage":{"@id":"{{ canonicalUrl }}#webpage"},"author":{"@id":"{{ site.organizationId }}"},"publisher":{"@id":"{{ site.organizationId }}"},"mentions":{"@id":"{{ canonicalUrl }}#providers"}},
  {"@type":"BreadcrumbList","@id":"{{ canonicalUrl }}#breadcrumb","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"{{ site.url }}/"},{"@type":"ListItem","position":2,"name":"Outbound Sales Library","item":"{{ site.url }}/resources/outbound-sales-library/"},{"@type":"ListItem","position":3,"name":{{ guide.breadcrumb | json | safe }},"item":"{{ canonicalUrl }}"}]},
  {"@type":"ItemList","@id":"{{ canonicalUrl }}#providers","name":{{ guide.breadcrumb | json | safe }},"itemListOrder":"https://schema.org/ItemListUnordered","numberOfItems":{{ guide.providers | length }},"itemListElement":[{% for provider in guide.providers %}{"@type":"ListItem","position":{{ loop.index }},"name":{{ provider.name | json | safe }},"url":"{{ canonicalUrl }}#{{ provider.id }}"}{% if not loop.last %},{% endif %}{% endfor %}]},
  {"@type":"FAQPage","@id":"{{ canonicalUrl }}#questions","mainEntity":[{% for faq in guide.faqs %}{"@type":"Question","name":{{ faq.question | json | safe }},"acceptedAnswer":{"@type":"Answer","text":{{ faq.answer | json | safe }}}}{% if not loop.last %},{% endif %}{% endfor %}]}
]}
</script>

<main class="lp-page agency-shortlist" id="simple-guide">
  <div class="lp-hero-shell"><div class="lp-wrap">
    <nav class="lp-breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><a href="/resources/outbound-sales-library/">Outbound Sales Library</a><span aria-hidden="true">/</span><span aria-current="page">{{ guide.breadcrumb }}</span></nav>
    <div class="lp-hero">
      <div>
        <h1>{{ title }}</h1>
        <p class="lp-intro">{{ guide.intro }}</p>
        <div class="lp-actions"><a class="lp-button" href="#compare">{{ guide.tableButton }}</a><a class="lp-text-link" href="#callteam-process">See CallTeam’s work</a></div>
      </div>
      <aside class="lp-brief shortlist-brief" aria-labelledby="shortlist-quick-answer">
        <h2 id="shortlist-quick-answer">{{ guide.quickHeading }}</h2>
        <ul>
          {% for choice in guide.quickChoices %}
          <li><strong>{{ choice.label }}</strong><a href="#{{ choice.anchor }}">{{ choice.name }}</a> {{ choice.reason }}</li>
          {% endfor %}
        </ul>
      </aside>
    </div>
  </div></div>

  <nav class="lp-jump" aria-label="On this page"><div class="lp-wrap">
    <a href="#compare">Provider table</a><a href="#callteam-process">CallTeam’s work</a><a href="#{{ guide.buyerSection[0] }}">{{ guide.buyerSection[1] }}</a><a href="#verdicts">Provider verdicts</a><a href="#quote-checklist">Quote questions</a><a href="#questions">FAQs</a>
  </div></nav>

  <section class="lp-section" id="compare"><div class="lp-wrap">
    <div class="lp-heading">
      <h2>{{ guide.tableHeading }}</h2>
      <p>{{ guide.method }} CallTeam publishes this guide and sells managed calling. Provider sources checked <time datetime="{{ modified }}">November 23, 2026</time>.</p>
    </div>
    <div class="sg-table-wrap">
      <table class="lp-table sg-table shortlist-table" role="table">
        <caption>{{ guide.tableCaption }}</caption>
        <thead><tr role="row"><th scope="col" role="columnheader">Provider</th>{% for col in guide.columns %}<th scope="col" role="columnheader">{{ col }}</th>{% endfor %}</tr></thead>
        <tbody>
          {% for provider in guide.providers %}
          <tr role="row"{% if provider.id == "callteam" %} class="shortlist-callteam"{% endif %}>
            <th scope="row" role="rowheader"><a href="#{{ provider.id }}">{{ provider.name }}</a></th>
            {% for cell in provider.cells %}<td role="cell" data-label="{{ guide.columns[loop.index0] }}">{{ cell }}</td>{% endfor %}
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
    <p class="shortlist-note">{{ guide.priceNote }}</p>
  </div></section>

  {{ content | safe }}

  <section class="lp-section lp-paper" id="verdicts"><div class="lp-wrap">
    <div class="lp-heading"><h2>{{ guide.verdictHeading }}</h2></div>
    {% for provider in guide.providers %}
    <article class="lp-provider shortlist-review" id="{{ provider.id }}">
      <header class="lp-provider-head"><h3>{{ provider.name }}</h3><p>{{ provider.headline }}</p></header>
      <div class="lp-provider-body">
        <div class="lp-provider-detail"><h4>When to hire</h4><p>{{ provider.verdict }}</p></div>
        <aside class="lp-verdict"><h4>{{ provider.checkTitle }}</h4><p>{{ provider.check }}</p></aside>
      </div>
      <ul class="shortlist-sources" aria-label="{{ provider.name }} sources">
        {% for source in provider.sources %}<li><a href="{{ source[1] }}">{{ source[0] }}</a></li>{% endfor %}
      </ul>
    </article>
    {% endfor %}
  </div></section>

  <section class="lp-section" id="quote-checklist"><div class="lp-wrap">
    <div class="lp-heading"><h2>{{ guide.quoteHeading }}</h2><p>{{ guide.quoteIntro }}</p></div>
    <div class="sg-resource shortlist-quote">
      <pre id="sg-resource-text" tabindex="-1">{% for question in guide.quoteQuestions %}{{ loop.index }}. {{ question }}{% if not loop.last %}{{ "\n" }}{% endif %}{% endfor %}</pre>
      <button class="lp-button" type="button" id="sg-copy-resource" hidden>Copy the five questions</button>
      <p id="sg-copy-status" role="status" aria-live="polite"></p>
    </div>
    <div class="lp-actions"><a class="lp-text-link" href="/lead-generation-proposal-comparison/">Compare agency proposals</a><a class="lp-text-link" href="{{ guide.related[1] }}">{{ guide.related[0] }}</a></div>
  </div></section>

  <section class="lp-section lp-paper" id="questions"><div class="lp-wrap lp-faq-wrap">
    <div class="lp-heading"><h2>{{ guide.faqHeading }}</h2></div>
    <div class="lp-faqs">{% for faq in guide.faqs %}<details><summary>{{ faq.question }}</summary><p>{{ faq.answer }}</p></details>{% endfor %}</div>
  </div></section>

  <section class="lp-section shortlist-close"><div class="lp-wrap">
    <div class="lp-heading"><h2>{{ guide.ctaHeading }}</h2><p>{{ guide.ctaCopy }}</p></div>
    <div class="lp-actions"><a class="lp-button" href="https://calendly.com/hello-callteam/new-meeting" target="_blank" rel="noopener" data-booking-placement="{{ shortlistKey }}-agency-shortlist">Book a free 30-minute call</a><a class="lp-text-link" href="{{ guide.service[1] }}">{{ guide.service[0] }}</a></div>
  </div></section>
</main>

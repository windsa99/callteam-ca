---
layout: layouts/base.njk
ogType: article
pageStyles:
  - "/assets/css/named-case-study.css"
  - "/assets/css/contextual-tools.css"
---
{% set caseHeadline = headline + " " + headlineResult %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": "{{ canonicalUrl }}#webpage",
      "url": "{{ canonicalUrl }}",
      "name": {{ title | json | safe }},
      "description": {{ description | json | safe }},
      "isPartOf": { "@id": "{{ site.websiteId }}" },
      "mainEntity": { "@id": "{{ canonicalUrl }}#article" },
      "breadcrumb": { "@id": "{{ canonicalUrl }}#breadcrumb" },
      "inLanguage": "en"
    },
    {
      "@type": "Article",
      "@id": "{{ canonicalUrl }}#article",
      "url": "{{ canonicalUrl }}",
      "mainEntityOfPage": { "@id": "{{ canonicalUrl }}#webpage" },
      "headline": {{ caseHeadline | json | safe }},
      "description": {{ description | json | safe }},
      "datePublished": "{{ modified }}",
      "dateModified": "{{ modified }}",
      "author": { "@id": "{{ site.organizationId }}" },
      "publisher": { "@id": "{{ site.organizationId }}" },
      "about": [
        { "@type": "Organization", "name": {{ client.name | json | safe }}, "url": {{ client.url | json | safe }} }
        {% for topic in caseTopics %},{ "@type": "Thing", "name": {{ topic | json | safe }} }{% endfor %}
      ]{% if publicEvidence %},
      "citation": {{ publicEvidence.url | json | safe }}{% endif %}
    },
    {
      "@type": "BreadcrumbList",
      "@id": "{{ canonicalUrl }}#breadcrumb",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "{{ site.url }}/" },
        { "@type": "ListItem", "position": 2, "name": "Case Studies", "item": "{{ site.url }}/case-studies/" },
        { "@type": "ListItem", "position": 3, "name": {{ client.name | json | safe }}, "item": "{{ canonicalUrl }}" }
      ]
    },
    {
      "@type": "FAQPage",
      "@id": "{{ canonicalUrl }}#faq",
      "mainEntity": [
        {% for item in caseFaqs %}
        { "@type": "Question", "name": {{ item.question | json | safe }}, "acceptedAnswer": { "@type": "Answer", "text": {{ item.answer | json | safe }} } }{% if not loop.last %},{% endif %}
        {% endfor %}
      ]
    }
  ]
}
</script>
{% include "components/case-study-v2-styles.njk" %}

<main class="cs2-page cs2-named-page">
  <nav class="breadcrumb-trail" aria-label="Breadcrumb">
    <div class="container"><a href="/">Home</a> / <a href="/case-studies/">Case Studies</a> / <span aria-current="page">{{ client.name }}</span></div>
  </nav>

  <section class="hero cs2-hero" aria-labelledby="case-title">
    <div>
      <div class="cs2-eyebrow">Named case study · Our team’s campaign experience</div>
      <h1 id="case-title">{{ headline }} <span class="highlight">{{ headlineResult }}</span></h1>
      <p class="cs2-lead">{{ caseLead }}</p>
      <div class="named-case-actions">
        <a class="btn-primary" href="#campaign-results">See the campaign results</a>
        <a href="{{ serviceLink.url }}">{{ serviceLink.name }} <span aria-hidden="true">→</span></a>
      </div>
    </div>

    <aside class="cs2-console" aria-label="{{ client.name }} campaign snapshot">
      <div class="cs2-console-head"><span>CAMPAIGN SNAPSHOT</span><strong>OUTBOUND CALLING</strong></div>
      <div class="named-case-client">
        <img src="{{ client.logo }}" alt="" width="128" height="64" decoding="async">
        <div><span>Company we worked for</span><strong>{{ client.name }}</strong></div>
      </div>
      <div class="cs2-console-results">
        {% for result in caseResults %}
        <div><strong>{{ result.value }}</strong><span>{{ result.label }}</span></div>
        {% endfor %}
      </div>
      <p class="named-case-measurement">{{ measurementNote }}</p>
    </aside>
  </section>

  {{ content | safe }}

  <section class="cs2-results" id="campaign-results" aria-labelledby="campaign-results-title">
    <div class="container-wide">
      <div class="section-label">Campaign results</div>
      <h2 id="campaign-results-title">{{ resultsHeading }}</h2>
      <div class="cs2-result-grid">
        {% for result in caseResults %}
        <article><span>{{ result.label }}</span><strong>{{ result.value }}</strong><small>{{ result.detail }}</small></article>
        {% endfor %}
      </div>
      <div class="cs2-evidence"><strong>Campaign figures.</strong> {{ measurementNote }}</div>
    </div>
  </section>

  {% if publicEvidence %}
  <section class="named-case-public-proof" aria-labelledby="public-proof-title">
    <div class="container-wide">
      <div class="section-label">Public project evidence</div>
      <div class="named-case-evidence-grid">
        <div>
          <h2 id="public-proof-title">{{ publicEvidence.heading }}</h2>
          <p>{{ publicEvidence.description }}</p>
          <a href="{{ publicEvidence.url }}">{{ publicEvidence.linkText }} <span aria-hidden="true">↗</span></a>
        </div>
        <aside class="cs2-card" aria-label="Published research scope">
          <span class="cs2-kicker">{{ client.name }} · Published research</span>
          <strong>{{ publicEvidence.figure }}</strong>
          <p>{{ publicEvidence.figureLabel }}</p>
        </aside>
      </div>
    </div>
  </section>
  {% endif %}

  <section aria-labelledby="case-apply-title">
    <div class="container-wide">
      <div class="section-label">Apply the approach</div>
      <h2 id="case-apply-title">{{ applyHeading }}</h2>
      <p class="cs2-intro">{{ applyCopy }}</p>
      {% set contextToolCta = campaignTool %}
      {% include "components/contextual-tool-cta.njk" %}
      <div class="cs2-related-grid named-case-related">
        <a href="{{ serviceLink.url }}"><span>Related service</span><strong>{{ serviceLink.name }}</strong><small>{{ serviceLink.description }}</small></a>
        <a href="{{ relatedCase.url }}"><span>Related case study</span><strong>{{ relatedCase.name }}</strong><small>{{ relatedCase.description }}</small></a>
        <a href="/case-studies/"><span>Case study library</span><strong>See all B2B sales case studies</strong><small>Compare audiences, campaign decisions, and commercial outcomes.</small></a>
      </div>
    </div>
  </section>

  <section id="faq" aria-labelledby="case-faq-title">
    <div class="container-wide">
      <div class="section-label">Campaign FAQ</div>
      <h2 id="case-faq-title">Questions about the {{ client.name }} campaign</h2>
      <div class="cs2-faq-list">
        {% for item in caseFaqs %}
        <details><summary>{{ item.question }}</summary><p>{{ item.answer }}</p></details>
        {% endfor %}
      </div>
    </div>
  </section>

  <section class="cta-band">
    <div class="section-label">Talk to CallTeam</div>
    <h2>{{ bookingHeading }}</h2>
    <p>{{ bookingCopy }}</p>
    <a href="https://calendly.com/hello-callteam/new-meeting" class="btn-light" target="_blank" rel="noopener" data-booking-placement="closing">Book a Free Strategy Call</a>
  </section>
</main>

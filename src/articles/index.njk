<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      "@id": "https://www.callteam.ca/articles/#webpage",
      "url": "https://www.callteam.ca/articles/",
      "name": "B2B Sales, Cold Calling and Lead Generation Guides",
      "description": {{ description | json | safe }},
      "isPartOf": { "@id": "{{ site.websiteId }}" },
      "mainEntity": { "@id": "https://www.callteam.ca/articles/#articles" },
      "inLanguage": "en"
    },
    {
      "@type": "ItemList",
      "@id": "https://www.callteam.ca/articles/#articles",
      "name": "CallTeam B2B sales article library",
      "numberOfItems": {{ collections.articles.length }},
      "itemListElement": [
        {%- for article in collections.articles | reverse %}
        {
          "@type": "ListItem",
          "position": {{ loop.index }},
          "url": "{{ site.url }}{{ article.url }}",
          "name": {{ article.data.title | json | safe }}
        }{% if not loop.last %},{% endif %}
        {%- endfor %}
      ]
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "{{ site.url }}/" },
        { "@type": "ListItem", "position": 2, "name": "Articles", "item": "{{ site.url }}/articles/" }
      ]
    }
  ]
}
</script>


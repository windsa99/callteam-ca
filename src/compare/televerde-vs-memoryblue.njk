          <div class="lp-actions">
            <a class="lp-button" href="#comparison">Compare the Two Providers <span aria-hidden="true">↓</span></a>
            <a class="lp-text-link" href="#hire-callteam">When to hire CallTeam <span aria-hidden="true">→</span></a>

title: "CallTeam Named a 2027 Canadian Choice Award Official Nominee"
seoTitle: "CallTeam Named a 2027 Canadian Choice Award Official Nominee"
description: "CallTeam is a 2027 Canadian Choice Award Official Nominee in Marketing Agencies. Explore our B2B lead generation, cold calling and four award wins."
canonicalUrl: "https://www.callteam.ca/awards/canadian-choice-award-2027/"
contentLanguage: "en-CA"
date: "2026-11-26"
modified: "2026-11-26"
ogType: "article"
pageStyles:
  - "/assets/css/commercial-services.css"
  - "/assets/css/process-video-preview.css"
  - "/assets/css/canadian-choice-award.css"
socialImage: "https://www.callteam.ca/assets/images/awards/canadian-choice-2027-official-nominee.webp"
socialImageWidth: 704
socialImageHeight: 880
socialImageAlt: "2027 Canadian Choice Award Official Nominee badge"
---
{% from "components/process-video-preview.njk" import processVideoPreview %}
{% set nomination = canadianChoiceAward2027 %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": "{{ canonicalUrl }}#webpage",
      "url": "{{ canonicalUrl }}",
      "name": {{ title | json | safe }},
      "description": {{ description | json | safe }},
      "isPartOf": {"@id": "{{ site.websiteId }}"},
      "mainEntity": {"@id": "{{ canonicalUrl }}#article"},
      "primaryImageOfPage": {"@id": "{{ canonicalUrl }}#nominee-badge"},
      "breadcrumb": {"@id": "{{ canonicalUrl }}#breadcrumbs"},
      "inLanguage": "en-CA"
    },
    {
      "@type": "Article",
      "@id": "{{ canonicalUrl }}#article",
      "headline": {{ title | json | safe }},
      "description": {{ description | json | safe }},
      "url": "{{ canonicalUrl }}",
      "datePublished": "{{ nomination.confirmedDate }}",
      "dateModified": "{{ modified }}",
      "author": {"@id": "{{ site.organizationId }}"},
      "publisher": {"@id": "{{ site.organizationId }}"},
      "about": {"@id": "{{ site.organizationId }}"},
      "image": {"@id": "{{ canonicalUrl }}#nominee-badge"},
      "citation": {{ nomination.sourceUrl | json | safe }},
      "mainEntityOfPage": {"@id": "{{ canonicalUrl }}#webpage"},
      "inLanguage": "en-CA"
    },
    {
      "@type": "ImageObject",
      "@id": "{{ canonicalUrl }}#nominee-badge",
      "url": "{{ site.url }}{{ nomination.image }}",
      "width": {{ nomination.imageWidth }},
      "height": {{ nomination.imageHeight }},
      "caption": {{ nomination.imageAlt | json | safe }}
    },
    {
      "@type": "BreadcrumbList",
      "@id": "{{ canonicalUrl }}#breadcrumbs",
      "itemListElement": [
        {"@type": "ListItem", "position": 1, "name": "Home", "item": "{{ site.url }}/"},
        {"@type": "ListItem", "position": 2, "name": "Awards & Recognition", "item": "{{ site.url }}/awards/"},
        {"@type": "ListItem", "position": 3, "name": "2027 Canadian Choice Award Nomination", "item": "{{ canonicalUrl }}"}
      ]
    }
  ]
}
</script>
<main class="mp-page cca-page">
  <div class="mp-hero-shell">
    <div class="mp-wrap">
      <nav class="mp-breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a><span aria-hidden="true">/</span>
        <a href="/awards/">Awards &amp; Recognition</a><span aria-hidden="true">/</span>
        <span aria-current="page">2027 Canadian Choice Award</span>
      </nav>
      <div class="mp-hero cca-hero">
        <div>
          <p class="cca-publisher">CallTeam announcement · <time datetime="{{ nomination.confirmedDate }}">{{ nomination.confirmedDateLabel }}</time></p>
          <h1>CallTeam Named a {{ nomination.year }} {{ nomination.programme }} <span>{{ nomination.status }}</span></h1>
          <p class="cca-lead">Canadian Choice Award confirmed our nomination in the {{ nomination.category }} category for {{ nomination.location }}.</p>
          <p>Thank you to the clients and supporters who have trusted our team with their outbound sales work.</p>
          <div class="mp-actions">
            <a class="mp-button" href="#about-callteam">See CallTeam’s work</a>
            <a class="mp-text-link" href="{{ nomination.sourceUrl }}">See the official nominee stage</a>
          </div>
        </div>
        <div class="cca-badge-card">
          <img
            src="{{ nomination.image }}"
            width="{{ nomination.imageWidth }}"
            height="{{ nomination.imageHeight }}"
            alt="{{ nomination.imageAlt }}"
            fetchpriority="high"
            decoding="async"
          >
        </div>
      </div>
    </div>
  </div>

  <section class="cca-stage" aria-labelledby="nomination-stage">
    <div class="mp-wrap">
      <h2 id="nomination-stage">What happens next</h2>
      <p>The programme reviews Official Nominees for its Top 3 Finalists stage in each category and city. <a href="{{ nomination.processUrl }}">Read the Canadian Choice Award process</a>.</p>
    </div>
  </section>

  <section class="mp-section" id="about-callteam" aria-labelledby="about-callteam-heading">
    <div class="mp-wrap">
      <div class="mp-split">
        <div>
          <h2 id="about-callteam-heading">About CallTeam</h2>
          <p>CallTeam is a B2B lead generation agency. Our services include human-led cold calling, appointment setting, lead reactivation, outsourced SDR services and sales training.</p>
          <p>We research target accounts and follow up with decision-makers. Your sales team gets the buyer’s priorities, questions and agreed next step before the meeting.</p>
          <div class="mp-actions">
            <a class="mp-text-link" href="/about/">Meet CallTeam</a>
            <a class="mp-text-link" href="/services/">Explore all CallTeam services</a>
          </div>
        </div>
        {{ processVideoPreview("How CallTeam works · 78 seconds", "Follow a campaign from prospect list to qualified meeting.", "canadian-choice-award") }}
      </div>
      <article class="cca-proof">
        <div>
          <h3>A SaaS appointment setting campaign</h3>
          <p>CallTeam booked <strong>11 qualified demos</strong> in 90 days. Four sales opportunities followed, and the client signed two customers within six months.</p>
        </div>
        <a class="mp-text-link" href="/case-studies/saas-demo-appointment-setting/">Read the SaaS case study</a>
      </article>
    </div>
  </section>

  <section class="mp-section mp-paper" id="award-wins" aria-labelledby="award-wins-heading">
    <div class="mp-wrap">
      <div class="mp-heading">
        <h2 id="award-wins-heading">CallTeam’s four award wins</h2>
      </div>
      <ul class="cca-wins">
        {% for key, award in awards %}
        <li>
          <a href="{{ award.url }}">
            <span>{{ award.programme }} · {{ award.edition }}</span>
            <strong>{{ award.title }}</strong>
          </a>
        </li>
        {% endfor %}
      </ul>
      <a class="mp-text-link" href="/awards/">Explore CallTeam’s awards and recognition</a>
    </div>
  </section>

  <section class="mp-final">
    <div class="mp-wrap">
      <h2>Talk through your next outbound campaign</h2>
      <p>Bring your offer and the market you want to reach. We’ll discuss who to call and what makes a meeting worth taking.</p>
      <a class="mp-button" href="https://calendly.com/hello-callteam/new-meeting" target="_blank" rel="noopener" data-booking-placement="canadian-choice-award-closing">Book a Free Call</a>
    </div>
  </section>
</main>

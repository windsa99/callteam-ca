<script type="application/ld+json">
{"@context":"https://schema.org","@graph":[{"@type":"CollectionPage","@id":"{{ canonicalUrl }}#webpage","url":"{{ canonicalUrl }}","name":{{ title | json | safe }},"description":{{ description | json | safe }},"dateModified":"{{ modified }}","inLanguage":"en-CA","isPartOf":{"@id":"{{ site.websiteId }}"},"about":{"@id":"{{ site.organizationId }}"},"mainEntity":{"@id":"{{ canonicalUrl }}#recognition"},"hasPart":{"@id":"{{ canonicalUrl }}#award-questions"}},{"@type":"ItemList","@id":"{{ canonicalUrl }}#recognition","name":"CallTeam awards and recognition","numberOfItems":{{ recognition.names | length }},"itemListElement":[{% for key, award in awards %}{"@type":"ListItem","position":{{ loop.index }},"name":{{ (award.title ~ ' | ' ~ award.programme ~ ' | ' ~ award.edition) | json | safe }},"url":"{{ site.url }}{{ award.url }}"}{% if not loop.last %},{% endif %}{% endfor %}]},{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"{{ site.url }}/"},{"@type":"ListItem","position":2,"name":"Awards & Recognition","item":"{{ canonicalUrl }}"}]},{"@type":"FAQPage","@id":"{{ canonicalUrl }}#award-questions","mainEntity":[{% for item in awardsHub.faq %}{"@type":"Question","name":{{ item.q | json | safe }},"acceptedAnswer":{"@type":"Answer","text":{{ item.a | json | safe }}}}{% if not loop.last %},{% endif %}{% endfor %}]}]}
</script>
<nav class="breadcrumb-trail" aria-label="Breadcrumb"><div class="container-wide"><a href="/">Home</a> / <span>Awards & Recognition</span></div></nav>
<main class="awards-showcase">
  <section class="recognition-hero">
    <div class="container-wide">
      <div class="recognition-eyebrow">CallTeam awards & recognition</div>
      <h1>Multi-award-winning<br><span>B2B outbound sales execution.</span></h1>
      <p class="recognition-lead">Recognised for the research, conversations and qualification behind B2B sales opportunities.</p>
      <p class="recognition-story">International Elite 100, GPMG and Acquisition International have recognised CallTeam across outbound calling, lead generation, appointment setting and global sales execution. Explore the awarded titles, the GPMG judges’ feedback and the client campaigns behind our work.</p>
      <div class="recognition-actions"><a href="#recognition" class="btn-primary">Explore our awards ↓</a><a href="https://calendly.com/hello-callteam/new-meeting" class="recognition-text-link" target="_blank" rel="noopener">Book a Free Call →</a></div>
      <nav class="recognition-jump" aria-label="Explore CallTeam recognition"><a href="#judges-feedback">Judges’ feedback</a><a href="#campaign-results">Campaign results</a><a href="#award-questions">Award questions</a></nav>
      <div class="recognition-winners recognition-winners--three" id="recognition" aria-label="CallTeam award winners">
        {% for key, award in awards %}
        <article class="recognition-winner" id="{{ key }}">
          <a class="recognition-badge-link{% if award.imageKind == 'programme' %} recognition-badge-link--programme{% endif %}" data-award-key="{{ key }}" data-award-placement="awards-hub" href="{{ award.url }}" aria-label="Read CallTeam’s {{ award.programme }} {{ award.edition }} award announcement">
            <div class="recognition-programme"><span>{{ award.programme }}</span><strong>{{ award.edition }}</strong></div>
            <img src="{{ award.image }}" width="{{ award.imageWidth or award.size }}" height="{{ award.imageHeight or award.size }}" alt="{{ award.label }}" fetchpriority="high">
            <span class="recognition-winner-label">Award winner</span>
          </a>
          <div class="recognition-winner-copy">
            <h2>{{ award.title }}</h2>
            <p>{{ award.summary }}</p>
            <a class="recognition-text-link" href="{{ award.url }}">Read the {{ award.announcementLabel }} announcement →</a>
          </div>
        </article>
        {% endfor %}
      </div>
    </div>
  </section>

  <section class="recognition-experience" aria-labelledby="recognition-experience-heading">
    <div class="container-wide">
      <div class="recognition-eyebrow" id="recognition-experience-heading">The combined experience behind CallTeam</div>
      <div class="recognition-stat-grid">
        <div><strong>500,000+</strong><span>outbound calls</span></div>
        <div><strong>1,000+</strong><span>sellers coached</span></div>
        <div><strong>150+</strong><span>companies supported</span></div>
        <div><strong>Fortune 100/500</strong><span>sales environments</span></div>
      </div>
    </div>
  </section>

  <section class="recognition-judges" id="judges-feedback" aria-labelledby="judges-heading">

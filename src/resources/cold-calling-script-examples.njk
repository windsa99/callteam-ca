---
layout: layouts/base.njk
permalink: "/resources/cold-calling-script-examples/"
title: "Which Cold Calling Script Fits Your Next Call?"
seoTitle: "Best Cold Calling Script? 3 B2B Examples Compared | CallTeam"
description: "Compare three B2B cold calling script examples. See what to say when a buyer has a supplier, a hiring manager has an open role or a sales email went unanswered."
canonicalUrl: "https://www.callteam.ca/resources/cold-calling-script-examples/"
modified: "2026-11-04"
pageStyles: ["/assets/css/cold-call-examples.css"]
pageScripts: ["/assets/js/cold-call-examples.js"]
---
{% set featured = coldCallExamples[0] %}
{% macro actions(sourceId, context, href, linkText, event) %}
<div class="ce-controls" data-ce-controls>
  <div class="ce-actions">
    <button class="ce-copy" type="button" data-ce-copy="{{ sourceId }}" aria-label="{{ context }}" hidden>Copy this response</button>
    <a class="ce-action-link" href="{{ href }}" data-ce-event="{{ event }}">{{ linkText }}</a>
  </div>
  <p class="ce-status" role="status"></p>
  <div class="ce-manual" hidden>
    <label>Select and copy the response<textarea readonly rows="2"></textarea></label>
    <button type="button" data-ce-close>Close</button>
  </div>
</div>
{% endmacro %}
<script type="application/ld+json">
{
  "@context":"https://schema.org",
  "@graph":[
    {"@type":"CollectionPage","@id":"{{ canonicalUrl }}#webpage","url":"{{ canonicalUrl }}","name":{{ title | json | safe }},"description":{{ description | json | safe }},"inLanguage":"en","isPartOf":{"@id":"{{ site.websiteId }}"},"publisher":{"@id":"{{ site.organizationId }}"},"breadcrumb":{"@id":"{{ canonicalUrl }}#breadcrumb"},"mainEntity":{"@type":"ItemList","name":"Three B2B cold calling script examples","numberOfItems":{{ coldCallExamples.length }},"itemListElement":[{% for item in coldCallExamples %}{"@type":"ListItem","position":{{ loop.index }},"name":{{ item.heading | json | safe }},"url":"{{ canonicalUrl }}#{{ item.id }}"}{% if not loop.last %},{% endif %}{% endfor %}]}},
    {"@type":"BreadcrumbList","@id":"{{ canonicalUrl }}#breadcrumb","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"{{ site.url }}/"},{"@type":"ListItem","position":2,"name":"Cold call scripts","item":"{{ site.url }}/resources/cold-call-scripts/"},{"@type":"ListItem","position":3,"name":"Cold calling script examples","item":"{{ canonicalUrl }}"}]}
  ]
}
</script>
<main class="ce-page">
  <nav class="ce-crumb" aria-label="Breadcrumb"><div class="ce-wrap"><a href="/">Home</a><span aria-hidden="true">/</span><a href="/resources/cold-call-scripts/">Cold call scripts</a><span aria-hidden="true">/</span><span aria-current="page">Examples</span></div></nav>
  <section class="ce-hero" aria-labelledby="examples-title">
    <div class="ce-wrap ce-hero-grid">
      <div>
        <p class="ce-kicker"><span aria-hidden="true"></span>B2B cold calling script examples</p>
        <h1 id="examples-title">{{ title }}</h1>
        <p class="ce-lead">See what to say to a fleet manager, an IT hiring manager or a shipping lead.</p>
      </div>
      <aside class="ce-feature" aria-label="Illustrative CallTeam exchange from the fleet example">
        <div class="ce-feature-head"><span>CallTeam example</span><span>01 / 03</span></div>
        <div class="ce-voice"><span>{{ featured.buyer }}</span><p>“{{ featured.buyerLine }}”</p></div>
        <div class="ce-voice ce-feature-answer"><span>{{ featured.caller }}</span><p>“<span id="ce-featured-line">{{ featured.response }}</span>”</p></div>
        {{ actions("ce-featured-line", "Copy this response", "#compare", "Compare all 3", "script_examples_compare") }}
      </aside>
    </div>
  </section>

  <section class="ce-comparison" id="compare" aria-labelledby="ce-compare-title">
    <div class="ce-wrap">
      <p class="ce-kicker"><span aria-hidden="true"></span>Quick comparison</p>
      <h2 id="ce-compare-title">What do you need to find out?</h2>
      <nav class="ce-index" aria-label="Choose a cold calling situation">
        {% for item in coldCallExamples %}
        <a href="#{{ item.id }}" data-ce-event="script_examples_choose_{{ item.id | replace('-', '_') }}">
          <span class="ce-index-no" aria-hidden="true">{{ item.number }}</span>
          <span class="ce-index-name"><strong>{{ item.short }}</strong><small>{{ item.label }}</small></span>
          <span class="ce-index-question">{{ item.decision }}</span><span class="ce-arrow" aria-hidden="true">↓</span>
        </a>
        {% endfor %}
      </nav>
    </div>
  </section>

  <div class="ce-cases ce-wrap">
    {% for item in coldCallExamples %}
    <section class="ce-case" id="{{ item.id }}" aria-labelledby="heading-{{ item.id }}">
      <div class="ce-case-intro">
        <p class="ce-kicker"><span aria-hidden="true"></span>{{ item.number }} / {{ item.label }}</p>
        <h2 id="heading-{{ item.id }}">{{ item.heading }}</h2>
        <p>{{ item.intro }}</p>
      </div>
      <div class="ce-case-body">
        <div class="ce-dialogue" aria-label="Illustrative call">
          <p><strong>{{ item.caller }}</strong><span>“{{ item.opener }}”</span></p>
          <p><strong>{{ item.buyer }}</strong><span>“{{ item.buyerLine }}”</span></p>
          <p class="ce-dialogue-answer"><strong>{{ item.caller }}</strong><span>“<span id="reply-{{ item.id }}">{{ item.response }}</span>”</span></p>
        </div>
        {{ actions("reply-" + item.id, "Copy response for " + item.label, "/resources/cold-call-scripts/" + item.slug + "/", item.sourceLabel, "script_examples_full_script") }}
        <div class="ce-branches">
          <div><h3>{{ item.yesLabel }}</h3><p class="ce-say">“{{ item.yesWords }}”</p><p>{{ item.yesNote }}</p></div>
          <div><h3>{{ item.otherLabel }}</h3><p class="ce-say">“{{ item.otherWords }}”</p><p>{{ item.otherNote }}</p></div>
        </div>
      </div>
    </section>
    {% endfor %}
  </div>
  <section class="ce-next" aria-labelledby="ce-next-title"><div class="ce-wrap ce-next-grid">
    <div><p class="ce-kicker"><span aria-hidden="true"></span>B2B lead generation</p>
      <h2 id="ce-next-title">Want CallTeam to make these calls for your business?</h2>
      <p>Tell us what you sell and who makes the buying decision. CallTeam researches the accounts, makes the calls and books introductions when the buyer agrees to a next step.</p>
      <p>Running the calls in-house? Compare <a href="/resources/best-cold-calling-dialers/">10 cold calling dialers and their actual plan costs</a> before choosing the software.</p>
      <div class="ce-next-links"><a class="btn-primary" href="/services/b2b-cold-calling/" data-ce-event="script_examples_service_clicked">Explore managed B2B cold calling</a><a href="/b2b-outbound-campaign-planner/" data-ce-event="script_examples_planner_clicked">See how we’d call my market</a></div>
    </div>
    <aside aria-label="Campaign evidence and script sources"><h3>From a CallTeam campaign</h3>
      <p>In a separate professional services campaign, CallTeam booked six qualified meetings in 90 days. <a href="/case-studies/professional-services-appointment-setting/">Read the campaign case study.</a></p>
      <p class="ce-credit">The three conversations above are practice examples prepared by <a href="/about/">CallTeam</a>. Each one links to the full script it draws from.</p>
    </aside>
  </div></section>
  <nav class="ce-resources ce-wrap" aria-label="More cold calling resources">
    <a href="/resources/cold-call-scripts/">Browse all {{ callScripts.length }} cold calling scripts</a>
    <a href="/articles/cold-call-discovery-questions/#cold-call-questions-and-what-to-say-next">Practice cold call follow-up questions</a>
    <a href="/cold-call-script-checker/" data-ce-event="script_examples_checker_clicked">Check your own script</a>
    <a href="/services/b2b-appointment-setting/" data-ce-event="script_examples_service_clicked">B2B appointment setting</a>
  </nav>
</main>

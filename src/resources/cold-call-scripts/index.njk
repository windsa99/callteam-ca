<script>
(function () {
  var copyButton = document.getElementById('hub-copy');
  var status = document.getElementById('hub-copy-status');
  var manual = document.getElementById('hub-manual');
  var manualText = document.getElementById('hub-manual-text');

  function track(name) {
    if (typeof window.clarity === 'function') window.clarity('event', name);
  }

  function fullScript() {
    var lines = ['Illustrative CallTeam script · Calling a sales leader', ''];
    document.querySelectorAll('[data-hub-branch], [data-hub-line]').forEach(function (item) {
      if (item.hasAttribute('data-hub-branch')) {
        lines.push('', item.textContent.trim());
      } else {
        lines.push(item.querySelector('b').textContent + ': ' + item.querySelector('span').textContent);
      }
    });
    return lines.join('\n');
  }

  copyButton.hidden = false;
  copyButton.addEventListener('click', async function () {
    var script = fullScript();
    try {
      await navigator.clipboard.writeText(script);
      manual.hidden = true;
      status.textContent = 'Full script copied.';
      track('script_hub_full_script_copied');
    } catch (error) {
      manualText.value = script;
      manual.hidden = false;
      manualText.focus();
      manualText.select();
      status.textContent = 'The full script is selected below for manual copying.';
    }
  });
  document.getElementById('hub-manual-close').addEventListener('click', function () {
    manual.hidden = true;
    status.textContent = '';
    copyButton.focus();
  });
  document.getElementById('hub-find').addEventListener('click', function () {
    track('script_hub_find_industry');
  });

  var input = document.getElementById('script-search-input');
  var buttons = Array.from(document.querySelectorAll('[data-script-filter]'));
  var cards = Array.from(document.querySelectorAll('[data-script-card]'));
  var count = document.getElementById('script-result-count');
  var empty = document.getElementById('script-empty-state');
  var activeFilter = 'all';

  function updateLibrary() {
    var query = (input.value || '').trim().toLowerCase();
    var visible = 0;
    cards.forEach(function (card) {
      var matchesText = !query || card.getAttribute('data-search').toLowerCase().indexOf(query) !== -1;
      var tags = card.getAttribute('data-tags').split(' ');
      var matchesFilter = activeFilter === 'all' || tags.indexOf(activeFilter) !== -1;
      var show = matchesText && matchesFilter;
      card.hidden = !show;
      if (show) visible += 1;
    });
    count.textContent = visible === cards.length && !query && activeFilter === 'all' ? 'Showing all ' + visible + ' scripts' : 'Showing ' + visible + ' script' + (visible === 1 ? '' : 's');
    empty.hidden = visible !== 0;
  }

  input.addEventListener('input', updateLibrary);
  buttons.forEach(function (button) {
    button.addEventListener('click', function () {
      activeFilter = button.getAttribute('data-script-filter');
      buttons.forEach(function (item) {
        item.classList.toggle('is-active', item === button);
        item.setAttribute('aria-pressed', String(item === button));
      });
      updateLibrary();
    });
  });
})();
</script>
